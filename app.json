{
  "expo": {
    "name": "Exercise Counter",
    "slug": "exercise_counter",
    "owner": "abelcor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exercisecounter.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required to track your body pose and count exercise repetitions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.exercisecounter.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Camera access is required to track your body pose and count exercise repetitions.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "react-native-mediapipe-posedetection",
        {
          "assetsPaths": [
            "./assets/models/"
          ]
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "eb961e2a-eb85-42c6-a8bc-695a9887becc"
      }
    }
  }
}
