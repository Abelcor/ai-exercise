{
  "expo": {
    "name": "Exercise Counter",
    "slug": "exercise_counter",
    "owner": "abelcor",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb961e2a-eb85-42c6-a8bc-695a9887becc",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exercisecounter.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required to track your body pose and count exercise repetitions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.exercisecounter.app",
      "permissions": ["CAMERA"],
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "eb961e2a-eb85-42c6-a8bc-695a9887becc"
      }
    }
  }
}
